# ─── Vantix Backend — Environment Configuration ──────────────────────────────
# When hosting your backend (e.g. on Render, Railway, DigitalOcean, or EC2):

# 1. MongoDB Connection (e.g., MongoDB Atlas Cloud URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vantix?retryWrites=true&w=majority

# 2. JWT Secret for Admin Authentication
JWT_SECRET=vantix_super_secure_jwt_secret_production_2026

# 3. TEE Encryption Key (AES-256-GCM — 64 hex characters / 32 bytes)
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# 4. TEE Audit HMAC Signing Key (64 hex characters)
TEE_SIGNING_KEY=f1e2d3c4b5a6f7e8d9c0b1a2f3e4d5c6b7a8f9e0d1c2b3a4f5e6d7c8b9a0f1e2

# 5. Split-Brain AI Architecture Keys
# Groq (Lightning-fast per-prompt AI responses <5ms)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google AI Studio (Deep cross-session async analytics)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 6. Production Port & Environment
PORT=5000
NODE_ENV=production

# 7. Allowed Frontend Origins (CORS) — Set to your Vercel URL
# Example: https://vantix-admin.vercel.app
CORS_ORIGIN=https://vantix-admin.vercel.app,http://localhost:5173
